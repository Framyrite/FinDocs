# Local application settings. Environment variables override backend/.env.
FINDOCS_APP_NAME="FinDocs Backend"
FINDOCS_DEBUG=false

# Document storage (defaults to backend/data when unset)
# FINDOCS_DATA_DIR=/absolute/path/to/findocs-data
FINDOCS_MAX_TXT_SIZE_MB=10
FINDOCS_MAX_DOCUMENTS=100

# LLM provider: mock or ollama
FINDOCS_LLM_PROVIDER=mock

# Local Ollama server and model
FINDOCS_OLLAMA_BASE_URL=http://127.0.0.1:11434
FINDOCS_LLM_MODEL=qwen3.5:4b-q4_K_M

# LLM generation settings
FINDOCS_LLM_TIMEOUT_SECONDS=90
FINDOCS_LLM_TEMPERATURE=0
FINDOCS_LLM_MAX_OUTPUT_TOKENS=512
FINDOCS_LLM_CONTEXT_TOKENS=4096
