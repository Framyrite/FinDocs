# Режим frontend: false — реальные HTTP-запросы, true — демонстрационный mock.
# Если переменная отсутствует, используются реальные запросы.
# Это НЕ FINDOCS_LLM_PROVIDER: серверный MockLLM настраивается отдельно.
VITE_USE_MOCK=false

# Адрес API. В локальном npm run dev без значения используется /api.
# Vite передаёт /api/documents как /documents на http://127.0.0.1:8000.
VITE_API_BASE_URL=/api

# В production адрес необходимо задать при сборке. Для /api нужна
# отдельная маршрутизация на сервере: Vite dev proxy там не работает.
# Скопируйте нужные значения в .env. После изменения перезапустите Vite;
# для production необходима новая сборка. Секреты в VITE_* не размещаются.
