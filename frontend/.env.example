# Базовый путь API для локальной разработки через Vite dev proxy.
# /api/documents на Vite передаётся как /documents в FastAPI на 127.0.0.1:8000.
# Скопируйте в .env или обновите эту переменную в существующем .env.
# Пустое значение НЕ включает mock: режим выбирает USE_MOCK в src/api/index.ts.
VITE_API_BASE_URL=/api
